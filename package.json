{
  "name": "quest-grove",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/package-offline.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/adaptive.test.mjs tests/assets.test.mjs tests/sites-worker.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "verify": "npm test && npm run test:ui && npm run build",
    "format": "prettier --write src scripts tests *.json *.md .vscode/*.json"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.187.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
